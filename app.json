{
    "expo": {
        "name": "BTR Tourism",
        "slug": "btr-tourism",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/images/icon.png",
        "scheme": "btr-tourism",
        "userInterfaceStyle": "dark",
        "backgroundColor": "#0d1116",
        "navigationBar": {
            "backgroundColor": "#0d1116"
        },
        "newArchEnabled": true,
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "in.coolidance.btrtourism",
            "userInterfaceStyle": "dark"
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/images/adaptive-icon.png",
                "backgroundColor": "#0d1116"
            },
            "package": "in.coolidance.btrtourism",
            "userInterfaceStyle": "dark"
        },
        "web": {
            "bundler": "metro",
            "output": "static",
            "favicon": "./assets/images/favicon.png"
        },
        "plugins": [
            "expo-router",
            [
                "expo-splash-screen",
                {
                    "image": "./assets/images/splash-icon.png",
                    "imageWidth": 200,
                    "resizeMode": "contain",
                    "backgroundColor": "#0d1116"
                }
            ]
        ],
        "experiments": {
            "typedRoutes": true
        }
    }
}
